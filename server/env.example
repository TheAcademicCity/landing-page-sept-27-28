# Server
PORT=3010
NODE_ENV=production

# Public URL where this landing page is hosted (no trailing slash)
PUBLIC_SITE_URL=https://admission-enquiry.theacademiccity.com

# Primary landing slug (shared css/js/images at repo root)
LANDING_BASE_PATH=/best-boarding-school-india

# Additional replicas: comma-separated slugs; folder per slug at repo root (e.g. best-boarding-school-india-v1/)
LANDING_VARIANT_PATHS=/best-boarding-school-india-v1,/best-boarding-school-india-v1-fb,/best-boarding-school-india-fb

# Optional extra CORS origin (local static preview)
CLIENT_URL=http://localhost:8765

# Zoho CRM (do not commit real keys — use .env locally / server secrets in production)
ZOHO_ZAPIKEY=
